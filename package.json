{
  "name": "chatimbored",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client-web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm --workspace server run dev",
    "build": "npm --workspace server run build",
    "test": "npm --workspace server run test",
    "vercel-build": "node scripts/check-vercel-godot-build.mjs && node scripts/assemble-site.mjs && npm --workspace client-web run build -- --base=/play/ --outDir ../dist/play --emptyOutDir",
    "start": "npm --workspace server run start",
    "web": "npm --workspace client-web run dev",
    "build:web": "npm --workspace client-web run build"
  }
}
